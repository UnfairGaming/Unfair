<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" packages="net.minecraft,com.mojang">

    <Appenders>
        <Console name="SysOut" target="SYSTEM_OUT" follow="true">
            <PatternLayout pattern="[%style{%d{HH:mm:ss}}{bright blue}] [%style{%t}{magenta}/%highlight{%level}{FATAL=bright red bold, ERROR=bright red, WARN=bright yellow, INFO=bright green, DEBUG=bright cyan, TRACE=white}]: %style{%msg}{white}%n" />
        </Console>

        <Queue name="ServerGuiConsole">
            <PatternLayout pattern="[%d{HH:mm:ss}] [%c{1}/%level]: %msg%n"/>
        </Queue>

        <RollingRandomAccessFile
                name="File"
                fileName="logs/latest.log"
                filePattern="logs/%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="[%d{HH:mm:ss}] [%c{1}/%level]: %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <OnStartupTriggeringPolicy/>
            </Policies>
        </RollingRandomAccessFile>
    </Appenders>

    <Loggers>
        <!-- Authlib logs complete session request/response bodies at DEBUG, including access tokens. -->
        <Logger name="com.mojang.authlib.HttpAuthenticationService" level="info"/>

        <Root level="debug">
            <filters>
                <MarkerFilter marker="NETWORK_PACKETS" onMatch="DENY" onMismatch="NEUTRAL"/>
            </filters>
            <AppenderRef ref="SysOut"/>
            <AppenderRef ref="File"/>
            <AppenderRef ref="ServerGuiConsole"/>
        </Root>
    </Loggers>
</Configuration>
